# Local dev — copy to .env.local and fill in values
# This file is gitignored.

# Auth
HIVE_AUTH_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
HIVE_ALLOWED_EMAILS=singh.anirudh@gmail.com
# HIVE_AUTH_BASE_URL=http://localhost:5173

# Use mock data locally (no gateway needed)
VITE_MOCK_MODE=true

# Optional defense-in-depth API key
# VITE_HIVE_API_KEY=
# HIVE_API_KEY=

# Feature flag for next-gen real-time status panel
# VITE_ENABLE_REALTIME_STATUS_PANEL=false

# Feature flags for Activity Feed and Cost/Token Usage Tracker
# VITE_ENABLE_ACTIVITY_FEED=true
# VITE_ENABLE_USAGE_TRACKER=true

# Optional alert control-plane tuning
# HIVE_ALERTS_DIR=
# HIVE_ALERT_DEDUPE_WINDOW_MS=300000
# HIVE_ALERT_SUPPRESS_WINDOW_MS=900000

# Escalation dispatch (dry-run by default)
# HIVE_ESCALATION_DISPATCH_MODE=dry-run
# HIVE_DASHBOARD_URL=http://localhost:5173
# HIVE_ESCALATION_TELEGRAM_WEBHOOK_URL=
# HIVE_ESCALATION_TELEGRAM_WEBHOOK_TOKEN=
# HIVE_ESCALATION_TELEGRAM_CHANNEL=

# Or connect to local OpenClaw gateway:
# VITE_MOCK_MODE=false
# OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
# OPENCLAW_API_TOKEN=your-token-here
# HIVE_LIVE_STATUS_STALE_MS=90000
