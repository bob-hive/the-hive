# Local dev — copy to .env.local and fill in values
# This file is gitignored.

# Auth
HIVE_AUTH_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
HIVE_ALLOWED_EMAILS=singh.anirudh@gmail.com
# HIVE_AUTH_BASE_URL=http://localhost:5173

# Use mock data locally (no gateway needed)
VITE_MOCK_MODE=true

# Optional defense-in-depth API key
# VITE_HIVE_API_KEY=
# HIVE_API_KEY=

# Optional alert control-plane tuning
# HIVE_ALERTS_DIR=
# HIVE_ALERT_DEDUPE_WINDOW_MS=300000
# HIVE_ALERT_SUPPRESS_WINDOW_MS=900000

# Or connect to local OpenClaw gateway:
# VITE_MOCK_MODE=false
# OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
# OPENCLAW_API_TOKEN=your-token-here
