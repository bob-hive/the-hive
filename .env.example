# The Hive — environment variables
# Copy to .env.local for local development

# ── Mock mode ─────────────────────────────────────────────────────────────────
# Set to "true" to use mock data even if an API token is configured.
# Great for demos and local development without an OpenClaw instance.
VITE_MOCK_MODE=false

# ── API settings (frontend) ───────────────────────────────────────────────────
# Optional: protect /api/* routes with a shared secret key.
# Set VITE_HIVE_API_KEY here and HIVE_API_KEY in your Vercel env vars.
# VITE_HIVE_API_KEY=

# Optional: polling interval in milliseconds (default: 10000)
# VITE_POLL_INTERVAL_MS=10000

# Optional: if API lives at a different base URL (dev proxy, etc.)
# VITE_API_BASE_URL=

# ── Serverless function settings (Vercel env vars, NOT exposed to browser) ────
# OpenClaw gateway WebSocket URL (e.g. ws://127.0.0.1:18789 or wss://your-gateway.tailnet.ts.net)
# OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789

# OpenClaw gateway auth token (from ~/.openclaw/openclaw.json → gateway.auth.token)
# OPENCLAW_API_TOKEN=your-token-here

# Optional: API key that clients must send in X-Hive-Key header
# HIVE_API_KEY=

# ── Server-side mock mode override ────────────────────────────────────────────
# Forces serverless functions to return mock data regardless of token config.
# MOCK_MODE=true
