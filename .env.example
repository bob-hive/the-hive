# The Hive — environment variables
# Copy to .env.local for local development

# ── Auth (Google OAuth + allowlist) ───────────────────────────────────────────
# Strong random secret for signed auth cookies
HIVE_AUTH_SECRET=replace-with-a-long-random-secret

# Google OAuth (Web Application credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated allowlist (default is singh.anirudh@gmail.com if unset)
HIVE_ALLOWED_EMAILS=singh.anirudh@gmail.com

# Optional explicit base URL used for auth redirects
# HIVE_AUTH_BASE_URL=http://localhost:5173

# ── Mock mode ─────────────────────────────────────────────────────────────────
# Set to "true" to use mock data even if an API token is configured.
VITE_MOCK_MODE=false

# ── API settings (frontend) ───────────────────────────────────────────────────
# Optional defense-in-depth API key. Set both VITE_HIVE_API_KEY and HIVE_API_KEY.
# VITE_HIVE_API_KEY=

# Optional: polling interval in milliseconds (default: 10000)
# VITE_POLL_INTERVAL_MS=10000

# Optional: if API lives at a different base URL (dev proxy, etc.)
# VITE_API_BASE_URL=

# ── Serverless function settings (Vercel env vars, NOT exposed to browser) ────
# OpenClaw gateway WebSocket URL (e.g. ws://127.0.0.1:18789)
# OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789

# OpenClaw gateway auth token (from ~/.openclaw/openclaw.json → gateway.auth.token)
# OPENCLAW_API_TOKEN=your-token-here

# Optional: additional API key check required by sensitive API routes
# HIVE_API_KEY=

# Optional: restrict API CORS origin
# HIVE_CORS_ORIGIN=https://the-hive-omega.vercel.app

# ── Server-side mock mode override ────────────────────────────────────────────
# Forces serverless functions to return mock data regardless of token config.
# MOCK_MODE=true
